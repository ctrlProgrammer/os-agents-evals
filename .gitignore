.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Keys stay local. The example with the variable names stays in git.
.env
!.env.example

# Dataset contents stay local. The folder, datasets/_template and each
# dataset's prompts/ and result/ (no case data) stay in git.
# datasets/freezer/ stays on disk, prompts and results included.
datasets/*/*
!datasets/_template/**
!datasets/*/prompts/
!datasets/*/prompts/**
!datasets/*/result/
!datasets/*/result/**
datasets/freezer/
